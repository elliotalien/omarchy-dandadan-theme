#!/usr/bin/env python3
# Generate an Omarchy colors.toml + shell.bar.toml from a wallpaper image.
# Usage: wallpaper-colors-gen <image> <colors.toml-out> <bar.toml-out>

import sys
import colorsys
from PIL import Image


def clamp(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def hx(h, s, l):
    r, g, b = colorsys.hls_to_rgb((h % 360) / 360.0, clamp(l), clamp(s))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


img_path, colors_out, bar_out = sys.argv[1], sys.argv[2], sys.argv[3]

img = Image.open(img_path).convert("RGB")
img.thumbnail((120, 120))
pal = img.quantize(colors=12).convert("RGB")
counts = pal.getcolors(pal.width * pal.height) or []

entries = []  # (hue, sat, lum, weight)
for count, (r, g, b) in counts:
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    entries.append((h * 360, s, l, count))

total = sum(e[3] for e in entries) or 1
mean_lum = sum(e[2] * e[3] for e in entries) / total
dark = mean_lum < 0.5

# Accent: most frequent chromatic color, saturation floor so muted shots still pop.
def score(e):
    h, s, l, w = e
    return w * s
acc = max(entries, key=score)
AH, AS = acc[0], max(acc[1], 0.45)


def pick(target_h, sat, lum, fb_h):
    """Nearest image color to target hue, else synthesize at fallback hue."""
    best = min(entries, key=lambda e: hue_dist(e[0], target_h))
    if hue_dist(best[0], target_h) < 60 and best[1] > 0.2:
        return hx(best[0], min(best[1] + 0.15, 0.8), lum)
    return hx(fb_h, sat, lum)


al = 0.60 if dark else 0.45          # accent lightness
bl = 0.62 if dark else 0.42          # base ANSI lightness
hl = 0.72 if dark else 0.30          # bright ANSI lightness

if dark:
    bg, dbg, ddbg, lbg = 0.07, 0.05, 0.035, 0.16
    fg, dfg, lfg, bfg = 0.93, 0.55, 0.88, "#ffffff"
    sel, mut = 0.20, 0.38
    mode = "dark"
else:
    bg, dbg, ddbg, lbg = 0.93, 0.87, 0.80, 0.97
    fg, dfg, lfg, bfg = 0.15, 0.45, 0.10, "#080808"
    sel, mut = 0.78, 0.55
    mode = "light"

palette = {
    "mode": f'"{mode}"',
    "accent": hx(AH, AS, al),
    "selection": hx(AH, 0.38, sel),
    "muted": hx(AH, 0.25, mut),
    "background": hx(AH, 0.30, bg),
    "dark_background": hx(AH, 0.30, dbg),
    "darker_background": hx(AH, 0.30, ddbg),
    "lighter_background": hx(AH, 0.30, lbg),
    "foreground": hx(AH, 0.12, fg),
    "dark_foreground": hx(AH, 0.20, dfg),
    "light_foreground": hx(AH, 0.18, lfg),
    "bright_foreground": bfg,
    "red": pick(355, 0.65, bl, 350),
    "yellow": pick(45, 0.60, bl, 45),
    "orange": pick(25, 0.65, bl, 22),
    "green": pick(135, 0.50, bl, 135),
    "cyan": pick(185, 0.55, bl, 185),
    "blue": pick(230, 0.50, bl, 230),
    "magenta": pick(290, 0.55, bl, 290),
    "brown": hx(15, 0.35, 0.35 if dark else 0.40),
    "bright_red": pick(355, 0.70, hl, 350),
    "bright_yellow": pick(45, 0.70, hl, 45),
    "bright_green": pick(135, 0.55, hl, 135),
    "bright_cyan": pick(185, 0.60, hl, 185),
    "bright_blue": pick(230, 0.55, hl, 230),
    "bright_magenta": pick(290, 0.60, hl, 290),
}

order = [
    "mode", "accent", "selection", "muted",
    "background", "dark_background", "darker_background", "lighter_background",
    "foreground", "dark_foreground", "light_foreground", "bright_foreground",
    "red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown",
    "bright_red", "bright_yellow", "bright_green", "bright_cyan",
    "bright_blue", "bright_magenta",
]

groups = [
    ["mode"],
    ["accent", "selection", "muted"],
    ["background", "dark_background", "darker_background", "lighter_background"],
    ["foreground", "dark_foreground", "light_foreground", "bright_foreground"],
    ["red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown"],
    ["bright_red", "bright_yellow", "bright_green", "bright_cyan",
     "bright_blue", "bright_magenta"],
]

with open(colors_out, "w") as f:
    for i, g in enumerate(groups):
        for k in g:
            f.write(f'{k} = "{palette[k]}"\n' if k != "mode" else f"mode = {palette[k]}\n")
        if i < len(groups) - 1:
            f.write("\n")

with open(bar_out, "w") as f:
    f.write(f"""[bar]
background = "{palette["background"]}"
background-alpha = 0.55
text = "{palette["bright_foreground"]}"
active = "{palette["bright_red"]}"
scale-with-font = true
size-horizontal = 26
size-vertical = 28
""")
